# SoundCloud Downloader - Environment Variables
# Copy this file to .env and adjust values as needed

# Auto-update yt-dlp on startup (true/false)
AUTO_UPDATE_YTDLP=false

# Max concurrent downloads (Render free tier: keep at 2)
MAX_CONCURRENT_DOWNLOADS=2

# Rate limit: requests per minute per IP
RATE_LIMIT_PER_MINUTE=15

# File retention in minutes (auto-cleanup)
FILE_RETENTION_MINUTES=60

# Allowed download domains (comma-separated, empty = soundcloud only)
ALLOWED_DOMAINS=soundcloud.com,snd.sc,on.soundcloud.com

# Port (Render sets this automatically)
PORT=10000
